        "messages": {
          "values": [
            {
              "content": "=You are a lead reply classifier. Classify the reply below into exactly one label:\nInterested, Question, or Not Interested.\nReply with only the label, nothing else.\n\nReply: {{ $json.message }}"
            }
          ]
        },
        "simplify": true,
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000003",
